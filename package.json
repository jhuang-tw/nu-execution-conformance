{
  "name": "nu-execution-conformance",
  "version": "0.4.0",
  "description": "Runtime-free conformance tests for shared Nu execution contracts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./broker.d.ts",
      "import": "./broker.mjs"
    },
    "./broker": {
      "types": "./broker.d.ts",
      "import": "./broker.mjs"
    },
    "./redaction": {
      "types": "./redaction.d.ts",
      "import": "./redaction.mjs"
    },
    "./error-contract": {
      "types": "./error-contract.d.ts",
      "import": "./error-contract.mjs"
    },
    "./native-exit-code": {
      "types": "./native-exit-code.d.ts",
      "import": "./native-exit-code.mjs"
    }
  },
  "files": [
    "broker.d.ts",
    "broker.mjs",
    "redaction.d.ts",
    "redaction.mjs",
    "error-contract.d.ts",
    "error-contract.mjs",
    "native-exit-code.d.ts",
    "native-exit-code.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19 <27"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "node --check broker.mjs && node --check redaction.mjs && node --check error-contract.mjs && node --check native-exit-code.mjs && npm test && npm pack --dry-run"
  },
  "license": "MIT"
}
